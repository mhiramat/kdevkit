# Upstream Linux kernel tree(s)
/linux/
/linux-*/

# Out-of-tree build artifacts
/build/

# Generated clangd configuration (materialized by scripts/configure.sh)
/.clangd
/.cache/

# Durable local patch-stack & series metadata (outside linux/ and build/)
/.kdev/

# Local VSCode workspace settings (materialized by setup.sh from scripts/settings.json.template)
/.vscode/settings.json

# Local user config fragment
/configs/user.config

# Python Kconfig backend virtualenv & caches
/backend/.venv/
/backend/*.egg-info/
/backend/build/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
__pycache__/
*.py[cod]

# VSCode Extension frontend build & dependencies
/extension/node_modules/
/extension/dist/
/extension/.vscode-test/

# Independent Lean formal verification repository
/lean/
