{
  "name": "linux-kernel-dev",
  "displayName": "Linux Kernel Dev Suite",
  "description": "VSCode Linux Kernel Development Suite (Kconfig SAT Solver, Kprobes & Selftests)",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "kdev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:kdev.openKconfigEditor",
    "onCommand:kdev.restartKconfigBackend",
    "onCommand:kdev.selftest.selectTargets",
    "onCommand:kdev.selftest.syncTargetConfig",
    "onCommand:kdev.selftest.buildSelected",
    "onCommand:kdev.kprobe.openTracePlot",
    "onView:kdev.overview",
    "onView:kdev.kprobe.probesView",
    "onView:kdev.kprobe.eventsView",
    "onView:kdev.git.branchesView",
    "onView:kdev.git.stackView",
    "onView:workbench.view.testing",
    "onLanguage:c",
    "workspaceContains:build/current/shared/probes.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Linux Kernel Dev",
      "properties": {
        "kdev.kernelSrcDir": {
          "type": "string",
          "default": "linux",
          "description": "Path to the Linux kernel source directory relative to workspace root."
        },
        "kdev.buildDir": {
          "type": "string",
          "default": "build/current",
          "description": "Path to the out-of-tree kernel build directory relative to workspace root."
        },
        "kdev.arch": {
          "type": "string",
          "default": "x86_64",
          "description": "Target kernel architecture."
        },
        "kdev.layersFile": {
          "type": "string",
          "default": "",
          "description": "Optional path to the declarative Kconfig layers JSON manifest (defaults to <buildDir>/layers.json when empty)."
        },
        "kdev.pythonPath": {
          "type": "string",
          "default": "backend/.venv/bin/python",
          "description": "Path to the Python interpreter with kconfig_server installed."
        },
        "kdev.autoRestartClangd": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restart clangd after applying Kconfig changes."
        },
        "kdev.perfBin": {
          "type": "string",
          "default": "perf",
          "description": "Path or command name for the host perf binary."
        },
        "kdev.kprobe.traceGroup": {
          "type": "string",
          "default": "kdev",
          "description": "Tracefs event group prefix (isolates kdevkit probes under events/<group>/)."
        },
        "kdev.kprobe.maxTraceEvents": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Maximum events retained in memory per trace.log load to protect UI responsiveness."
        },
        "kdev.kprobe.autoLoadTrace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload trace.log when updated by QEMU."
        },
        "kdev.selftest.targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Whitelist of tools/testing/selftests/ targets shown in Test Explorer."
        },
        "kdev.selftest.excludeTests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ftrace:boottime-ktap"
          ],
          "description": "Test IDs (<target>:<test>) skipped when running parent targets inside QEMU (e.g. host-only tests that launch nested QEMU)."
        },
        "kdev.selftest.linkMode": {
          "type": "string",
          "enum": [
            "auto-libs",
            "static"
          ],
          "default": "auto-libs",
          "description": "Default C test binary strategy: auto-libs (Option A) or static (Option B)."
        },
        "kdev.selftest.targetOptions": {
          "type": "object",
          "default": {},
          "description": "Per-target selftest overrides (e.g. linkMode, timeoutSec, bootTimeoutSec)."
        },
        "kdev.selftest.checkConfigBeforeRun": {
          "type": "string",
          "enum": [
            "prompt",
            "off"
          ],
          "default": "prompt",
          "description": "Warn and offer Kconfig solver sync if target config requirements are missing from .config."
        },
        "kdev.selftest.timeoutSec": {
          "type": "number",
          "default": 1800,
          "minimum": 0,
          "description": "Overall QEMU selftest execution timeout in seconds (0 disables the overall cap; idleTimeoutSec still detects hangs)."
        },
        "kdev.selftest.bootTimeoutSec": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "Maximum wait time for guest kernel boot to reach run_target.sh."
        },
        "kdev.selftest.idleTimeoutSec": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "Inactivity watchdog timeout in seconds after guest boot; resets on every output line (0 disables)."
        },
        "kdev.selftest.autoBuildBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run scripts/build_selftest.sh before booting QEMU."
        },
        "kdev.selftest.keepRunScript": {
          "type": "boolean",
          "default": false,
          "description": "Keep build/current/shared/run_target.sh after QEMU exits for debugging."
        },
        "kdev.tracePlot.defaultTimebase": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative",
          "description": "Default X-axis timebase in Trace Plotter (relative t-t0 or raw kernel monotonic timestamp)."
        },
        "kdev.tracePlot.autoOpenOnSelftestTrace": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the Trace Plotter panel after a 'Run in QEMU with Active Kprobes' selftest finishes."
        },
        "kdev.git.topicPrefix": {
          "type": "string",
          "default": "topic/",
          "description": "Branch prefix identifying developer topic patch-series branches."
        },
        "kdev.git.reviewPrefix": {
          "type": "string",
          "default": "review/",
          "description": "Branch prefix identifying incoming patch review branches."
        },
        "kdev.git.maintainerPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "User-defined branch prefixes or exact/glob names for subsystem maintainer queues (e.g., [\"probes/\", \"bootconfig/\"])."
        },
        "kdev.git.fixesSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fixes",
            "urgent"
          ],
          "description": "Branch suffixes classified under the weekly fixes PR cadence."
        },
        "kdev.git.nextSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "for-next",
            "next",
            "core"
          ],
          "description": "Branch suffixes classified under the merge-window for-next PR cadence."
        },
        "kdev.git.stateDir": {
          "type": "string",
          "default": ".kdev/series",
          "description": "Durable metadata directory relative to workspace root (outside linux/ and build/)."
        },
        "kdev.git.b4Bin": {
          "type": "string",
          "default": "b4",
          "description": "Path or command name for the b4 executable."
        },
        "kdev.git.importSource": {
          "type": "string",
          "enum": [
            "undined-mcp",
            "b4"
          ],
          "default": "undined-mcp",
          "description": "Default mbox source when importing review branches ('undined-mcp' or 'b4')."
        },
        "kdev.git.prSkillCommand": {
          "type": "string",
          "default": "",
          "description": "Command template to invoke your existing Pull Request skill ({branch}, {contextFile}, {kernelDir})."
        },
        "kdev.undined.bin": {
          "type": "string",
          "default": "undined",
          "description": "Path or command name for the undined binary used for MCP STDIO (--mcp-stdio)."
        },
        "kdev.undined.configPath": {
          "type": "string",
          "default": "",
          "description": "Optional --config path passed to undined."
        },
        "kdev.undined.webBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "UndineD Web UI base URL for 'Open in UndineD' links."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kdevExplorer",
          "title": "kdevkit",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "kdevExplorer": [
        {
          "id": "kdev.git.branchesView",
          "name": "Kernel Branches"
        },
        {
          "id": "kdev.git.stackView",
          "name": "Patch Stack"
        },
        {
          "id": "kdev.kprobe.probesView",
          "name": "Configured Kprobes"
        },
        {
          "id": "kdev.kprobe.eventsView",
          "name": "Trace Events"
        }
      ]
    },
    "commands": [
      {
        "command": "kdev.openKconfigEditor",
        "title": "Kernel Dev: Open Kconfig Editor",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kdev.restartKconfigBackend",
        "title": "Kernel Dev: Restart Kconfig Backend"
      },
      {
        "command": "kdev.kprobe.addAtCursor",
        "title": "kdev: Add Kprobe at Cursor",
        "icon": "$(add)"
      },
      {
        "command": "kdev.kprobe.addReturnProbe",
        "title": "kdev: Add Return Probe ($retval)",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "kdev.kprobe.removeAtCursor",
        "title": "kdev: Remove Kprobe at Cursor",
        "icon": "$(trash)"
      },
      {
        "command": "kdev.kprobe.toggleProbe",
        "title": "kdev: Toggle Kprobe Enabled",
        "icon": "$(eye)"
      },
      {
        "command": "kdev.kprobe.editProbeVars",
        "title": "kdev: Edit Kprobe Variables",
        "icon": "$(edit)"
      },
      {
        "command": "kdev.kprobe.deleteProbe",
        "title": "kdev: Delete Kprobe",
        "icon": "$(trash)"
      },
      {
        "command": "kdev.kprobe.reResolveAll",
        "title": "kdev: Re-resolve All Kprobes",
        "icon": "$(refresh)"
      },
      {
        "command": "kdev.kprobe.exportSetupScript",
        "title": "kdev: Export Tracefs Setup Script",
        "icon": "$(export)"
      },
      {
        "command": "kdev.kprobe.loadTraceLog",
        "title": "kdev: Load Trace Log",
        "icon": "$(folder-opened)"
      },
      {
        "command": "kdev.kprobe.filterEvents",
        "title": "kdev: Filter Trace Events",
        "icon": "$(filter)"
      },
      {
        "command": "kdev.kprobe.clearAll",
        "title": "kdev: Clear All Kprobes",
        "icon": "$(clear-all)"
      },
      {
        "command": "kdev.kprobe.jumpToEvent",
        "title": "kdev: Jump to Probe/Event Line"
      },
      {
        "command": "kdev.kprobe.openTracePlot",
        "title": "kdev: Open Trace Plotter",
        "icon": "$(graph)"
      },
      {
        "command": "kdev.selftest.selectTargets",
        "title": "kdev: Select Selftest Targets...",
        "icon": "$(checklist)"
      },
      {
        "command": "kdev.selftest.syncTargetConfig",
        "title": "kdev: Inject & Solve Selftest Kconfig",
        "icon": "$(wrench)"
      },
      {
        "command": "kdev.selftest.buildSelected",
        "title": "kdev: Build Selected Selftests",
        "icon": "$(tools)"
      },
      {
        "command": "kdev.git.refreshViews",
        "title": "kdev: Refresh Patch Stack & Branches",
        "icon": "$(refresh)"
      },
      {
        "command": "kdev.git.newTopicBranch",
        "title": "kdev: New Topic Branch",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "kdev.git.checkoutBranch",
        "title": "kdev: Checkout Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "kdev.git.setBranchRole",
        "title": "kdev: Set Branch Role",
        "icon": "$(tag)"
      },
      {
        "command": "kdev.git.configureMaintainerBranches",
        "title": "kdev: Configure Maintainer Branches...",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kdev.git.refreshCommit",
        "title": "kdev: Refresh Changes into Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "kdev.git.rewordCommit",
        "title": "kdev: Edit Commit Message (Reword)",
        "icon": "$(edit)"
      },
      {
        "command": "kdev.git.moveCommitUp",
        "title": "kdev: Move Commit Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "kdev.git.moveCommitDown",
        "title": "kdev: Move Commit Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "kdev.git.dropCommit",
        "title": "kdev: Drop Commit",
        "icon": "$(trash)"
      },
      {
        "command": "kdev.git.movePatchesToBranch",
        "title": "kdev: Move Commit(s) to Another Branch...",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "kdev.git.undoStack",
        "title": "kdev: Undo Stack Operation",
        "icon": "$(discard)"
      },
      {
        "command": "kdev.git.popCommit",
        "title": "kdev: Pop Top Commit from Stack",
        "icon": "$(fold-down)"
      },
      {
        "command": "kdev.git.pushCommit",
        "title": "kdev: Push Popped Commit onto Stack",
        "icon": "$(fold-up)"
      },
      {
        "command": "kdev.git.continueConflict",
        "title": "kdev: Continue Rebase / Apply",
        "icon": "$(play)"
      },
      {
        "command": "kdev.git.skipConflict",
        "title": "kdev: Skip Conflicting Patch",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "kdev.git.abortConflict",
        "title": "kdev: Abort Rebase / Apply",
        "icon": "$(stop-circle)"
      },
      {
        "command": "kdev.git.editCoverLetter",
        "title": "kdev: Edit Series Cover Letter",
        "icon": "$(mail)"
      },
      {
        "command": "kdev.git.bumpSeriesVersion",
        "title": "kdev: Bump Series Version (range-diff)",
        "icon": "$(versions)"
      },
      {
        "command": "kdev.git.runPreflight",
        "title": "kdev: Run Series Preflight (checkpatch & maintainers)",
        "icon": "$(checklist)"
      },
      {
        "command": "kdev.git.stageSeriesToUndineD",
        "title": "kdev: Stage Patch Series to UndineD Drafts",
        "icon": "$(send)"
      },
      {
        "command": "kdev.git.importReviewBranch",
        "title": "kdev: Import Review Branch by Message-ID",
        "icon": "$(cloud-download)"
      },
      {
        "command": "kdev.git.applyToMaintainerBranch",
        "title": "kdev: Apply Patch to Maintainer Branch (b4 -l -s)",
        "icon": "$(inbox)"
      },
      {
        "command": "kdev.git.preparePullRequestContext",
        "title": "kdev: Prepare Pull Request Context",
        "icon": "$(file-code)"
      },
      {
        "command": "kdev.git.runPullRequestSkill",
        "title": "kdev: Run Pull Request Skill",
        "icon": "$(git-pull-request)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kdev.kprobe.addAtCursor",
          "when": "editorLangId == c",
          "group": "kdev@1"
        },
        {
          "command": "kdev.kprobe.addReturnProbe",
          "when": "editorLangId == c",
          "group": "kdev@2"
        },
        {
          "command": "kdev.kprobe.removeAtCursor",
          "when": "editorLangId == c",
          "group": "kdev@3"
        }
      ],
      "view/title": [
        {
          "command": "kdev.kprobe.reResolveAll",
          "when": "view == kdev.kprobe.probesView",
          "group": "navigation@1"
        },
        {
          "command": "kdev.kprobe.exportSetupScript",
          "when": "view == kdev.kprobe.probesView",
          "group": "navigation@2"
        },
        {
          "command": "kdev.kprobe.clearAll",
          "when": "view == kdev.kprobe.probesView",
          "group": "navigation@3"
        },
        {
          "command": "kdev.kprobe.loadTraceLog",
          "when": "view == kdev.kprobe.eventsView",
          "group": "navigation@1"
        },
        {
          "command": "kdev.kprobe.openTracePlot",
          "when": "view == kdev.kprobe.eventsView",
          "group": "navigation@2"
        },
        {
          "command": "kdev.kprobe.filterEvents",
          "when": "view == kdev.kprobe.eventsView",
          "group": "navigation@3"
        },
        {
          "command": "kdev.selftest.selectTargets",
          "when": "view == workbench.view.testing",
          "group": "navigation@10"
        },
        {
          "command": "kdev.selftest.buildSelected",
          "when": "view == workbench.view.testing",
          "group": "navigation@11"
        },
        {
          "command": "kdev.git.newTopicBranch",
          "when": "view == kdev.git.branchesView",
          "group": "navigation@1"
        },
        {
          "command": "kdev.git.importReviewBranch",
          "when": "view == kdev.git.branchesView",
          "group": "navigation@2"
        },
        {
          "command": "kdev.git.refreshViews",
          "when": "view == kdev.git.branchesView",
          "group": "navigation@3"
        },
        {
          "command": "kdev.git.undoStack",
          "when": "view == kdev.git.stackView",
          "group": "navigation@1"
        },
        {
          "command": "kdev.git.editCoverLetter",
          "when": "view == kdev.git.stackView",
          "group": "navigation@2"
        },
        {
          "command": "kdev.git.bumpSeriesVersion",
          "when": "view == kdev.git.stackView",
          "group": "navigation@3"
        },
        {
          "command": "kdev.git.runPreflight",
          "when": "view == kdev.git.stackView",
          "group": "navigation@4"
        },
        {
          "command": "kdev.git.stageSeriesToUndineD",
          "when": "view == kdev.git.stackView",
          "group": "navigation@5"
        },
        {
          "command": "kdev.git.applyToMaintainerBranch",
          "when": "view == kdev.git.stackView",
          "group": "navigation@6"
        },
        {
          "command": "kdev.git.runPullRequestSkill",
          "when": "view == kdev.git.stackView",
          "group": "navigation@7"
        }
      ],
      "testing/item/context": [
        {
          "command": "kdev.selftest.syncTargetConfig",
          "when": "controllerId == kdevSelftest",
          "group": "inline@1"
        },
        {
          "command": "kdev.selftest.syncTargetConfig",
          "when": "controllerId == kdevSelftest",
          "group": "1_kdev@1"
        },
        {
          "command": "kdev.selftest.buildSelected",
          "when": "controllerId == kdevSelftest",
          "group": "1_kdev@2"
        },
        {
          "command": "kdev.selftest.selectTargets",
          "when": "controllerId == kdevSelftest",
          "group": "1_kdev@3"
        }
      ],
      "view/item/context": [
        {
          "command": "kdev.kprobe.toggleProbe",
          "when": "view == kdev.kprobe.probesView && viewItem =~ /^kprobe/",
          "group": "inline@1"
        },
        {
          "command": "kdev.kprobe.deleteProbe",
          "when": "view == kdev.kprobe.probesView && viewItem =~ /^kprobe/",
          "group": "inline@2"
        },
        {
          "command": "kdev.kprobe.editProbeVars",
          "when": "view == kdev.kprobe.probesView && viewItem =~ /^kprobe/",
          "group": "1_modify@1"
        },
        {
          "command": "kdev.kprobe.toggleProbe",
          "when": "view == kdev.kprobe.probesView && viewItem =~ /^kprobe/",
          "group": "1_modify@2"
        },
        {
          "command": "kdev.kprobe.deleteProbe",
          "when": "view == kdev.kprobe.probesView && viewItem =~ /^kprobe/",
          "group": "1_modify@3"
        },
        {
          "command": "kdev.git.checkoutBranch",
          "when": "view == kdev.git.branchesView && viewItem =~ /^branch/",
          "group": "inline@1"
        },
        {
          "command": "kdev.git.setBranchRole",
          "when": "view == kdev.git.branchesView && viewItem =~ /^branch/",
          "group": "1_branch@1"
        },
        {
          "command": "kdev.git.runPullRequestSkill",
          "when": "view == kdev.git.branchesView && viewItem == branchMaintainer",
          "group": "1_branch@2"
        },
        {
          "command": "kdev.git.refreshCommit",
          "when": "view == kdev.git.stackView && viewItem =~ /^stackCommit/",
          "group": "inline@1"
        },
        {
          "command": "kdev.git.moveCommitUp",
          "when": "view == kdev.git.stackView && viewItem == stackCommitEditable",
          "group": "inline@2"
        },
        {
          "command": "kdev.git.moveCommitDown",
          "when": "view == kdev.git.stackView && viewItem == stackCommitEditable",
          "group": "inline@3"
        },
        {
          "command": "kdev.git.rewordCommit",
          "when": "view == kdev.git.stackView && viewItem =~ /^stackCommit/",
          "group": "1_edit@1"
        },
        {
          "command": "kdev.git.dropCommit",
          "when": "view == kdev.git.stackView && viewItem =~ /^stackCommit/",
          "group": "1_edit@2"
        },
        {
          "command": "kdev.git.movePatchesToBranch",
          "when": "view == kdev.git.stackView && viewItem == stackCommitEditable",
          "group": "1_edit@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test:unit": "vitest run test/unit",
    "test:ipc": "vitest run test/integration",
    "test:ipc:real": "REAL_KERNEL=1 vitest run test/integration",
    "test:e2e": "node ./dist/test/e2e/runTest.js",
    "test:all": "npm run typecheck && npm run build && npm run test:unit && npm run test:ipc"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
